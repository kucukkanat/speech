{
  "name": "@kucukkanat/speech-core",
  "version": "0.0.0",
  "description": "Shared plumbing for the @kucukkanat speech SDKs: typed worker RPC, engine status, typed errors, capability detection and bundler plugins for Vite, esbuild and Bun.",
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": {
      "@kucukkanat/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./vite": {
      "@kucukkanat/source": "./src/vite.ts",
      "types": "./dist/vite.d.ts",
      "default": "./dist/vite.js"
    },
    "./esbuild": {
      "@kucukkanat/source": "./src/esbuild.ts",
      "types": "./dist/esbuild.d.ts",
      "default": "./dist/esbuild.js"
    },
    "./bun": {
      "@kucukkanat/source": "./src/esbuild.ts",
      "types": "./dist/esbuild.d.ts",
      "default": "./dist/esbuild.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "src",
    "!**/*.test.ts"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kucukkanat/speech.git",
    "directory": "packages/speech-core"
  },
  "keywords": [
    "speech",
    "webgpu",
    "web-worker",
    "rpc",
    "transformers.js"
  ],
  "scripts": {
    "build": "bun ../../scripts/build-package.ts"
  },
  "dependencies": {
    "nanoevents": "^9.1.0"
  },
  "peerDependencies": {
    "vite": ">=6"
  },
  "peerDependenciesMeta": {
    "vite": {
      "optional": true
    }
  },
  "devDependencies": {
    "vite": "^8.3.1"
  }
}
